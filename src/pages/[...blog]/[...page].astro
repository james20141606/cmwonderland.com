---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import BlogList from '~/components/blog/List.astro';
import Pagination from '~/components/blog/Pagination.astro';
import CategoryChips from '~/components/blog/CategoryChips.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `Blog${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <div class="wl-wrap">
    <PageIntro
      label={currentPage > 1 ? `Notebook · page ${currentPage} of ${page.lastPage}` : `Notebook · ${page.total} entries`}
      title="The <em>Notebook</em>"
      lede="Research, AI, biology — and the strange tissue between them."
      ledeZh="研究、AI、生命，以及它们之间那些奇异的组织。"
    />

    <div class="blog-tools">
      <CategoryChips />
    </div>

    {currentPage === 1 && (
      <a class="wl-callout blog-shelf" href="/fun-pages/" data-astro-reload>
        <div>
          <span class="wl-label">A separate room</span>
          <h2>Fun &amp; <em>Curious</em> Papers</h2>
          <p>The papers I most enjoyed making, laid out like an editorial shelf — brains &amp; speech, AI &amp; the world, vision &amp; the edges, and one small love game.</p>
        </div>
        <span class="wl-arrow">Open the shelf</span>
      </a>
    )}

    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </div>
</Layout>

<style>
  .blog-tools { padding-bottom: 2rem; }
  .blog-shelf { margin-bottom: 2.5rem; }
</style>
