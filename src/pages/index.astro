---
import Layout from '~/layouts/PageLayout.astro';
import CortexTraces from '~/components/CortexTraces.astro';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

const posts = await fetchPosts();
const latest = posts.slice(0, 6);
const firstYear = Math.min(...posts.map((p) => p.publishDate.getFullYear()));

const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', timeZone: 'UTC' });

// Kept in step with the publication list on /about.
const work = [
  {
    year: '2024',
    title: 'A neural speech decoding framework leveraging deep learning and speech synthesis',
    venue: 'Nature Machine Intelligence',
    note: 'First author',
    href: 'https://doi.org/10.1038/s42256-024-00824-8',
  },
  {
    year: '2025',
    title: 'Transformer-based neural speech decoding from surface and depth electrode signals',
    venue: 'Journal of Neural Engineering',
    note: 'First author',
    href: 'https://iopscience.iop.org/article/10.1088/1741-2552/adab21',
  },
  {
    year: '2023',
    title: 'Distributed feedforward and feedback cortical processing supports human speech production',
    venue: 'PNAS',
    note: '',
    href: 'https://www.pnas.org/doi/10.1073/pnas.2300255120',
  },
  {
    year: '2025',
    title: 'R-LLaVA: improving Med-VQA understanding through visual region of interest',
    venue: 'IJCNN',
    note: 'First author',
    href: 'https://arxiv.org/abs/2410.20327',
  },
  {
    year: '2026',
    title: 'ENCORE: entropy-guided reward composition for multi-head safety reward models',
    venue: 'AAAI',
    note: '',
    href: 'https://arxiv.org/abs/2503.20995',
  },
];

const rooms = [
  { title: 'Fun & Curious Papers', zh: '', kind: 'Shelf', desc: 'The papers I most enjoyed making, laid out like an editorial shelf.', href: '/fun-pages/', reload: true },
  { title: 'Quantum Entanglement', zh: '量子纠缠', kind: 'Interactive', desc: 'Bloch spheres, Bell states, CHSH and the double slit — to play with.', href: '/quantum/', reload: true },
  { title: 'Finance Briefing', zh: '', kind: 'Daily', desc: 'Global markets and sector rotations, refreshed by an automated pipeline.', href: '/news', reload: false },
  { title: '陈炳林回忆录', zh: '', kind: 'Memoir', desc: '追忆我的爷爷——他亲笔写下的回忆录，重新排版成书。', href: '/posts/remember-grandpa', reload: false },
  { title: 'Projects', zh: '', kind: 'Category', desc: 'Built things. Broken things. Occasionally useful.', href: '/categories/projects', reload: false },
  { title: 'Anniversary Clock', zh: '致孟孟', kind: 'Personal', desc: '时光里的每一秒。', href: '/anniversary', reload: true },
];

const metadata = {
  title: 'Xupeng Chen — WonderLand',
  ignoreTitleTemplate: true,
  description:
    'Xupeng Chen — research scientist working on large language and multimodal models, and on decoding speech from the human brain. Papers, notes and a notebook kept since 2018.',
};
---

<Layout metadata={metadata}>
  <div class="wl-wrap">
    <section class="hero">
      <p class="wl-label wl-rise hero-eyebrow" style="--i:0"><span lang="zh">陈旭鹏</span><span>Brain &amp; AI in Future</span></p>
      <h1 class="wl-rise" style="--i:1">
        Xupeng <em>Chen</em>
      </h1>
      <div class="hero-grid">
        <p class="hero-lede wl-rise" style="--i:2">
          I work on large language and multimodal models, and on decoding speech from the human brain.
          Research scientist at TikTok in Seattle; Ph.D. in electrical engineering from NYU, and a
          biologist at Tsinghua before that.
        </p>
        <ul class="hero-links wl-rise" style="--i:3">
          <li><a class="wl-arrow" href="/about">About &amp; CV</a></li>
          <li><a class="wl-arrow" href="https://scholar.google.com/citations?user=d3HfTOsAAAAJ" rel="me noopener">Google Scholar</a></li>
          <li><a class="wl-arrow" href="https://github.com/james20141606" rel="me noopener">GitHub</a></li>
          <li><a class="wl-arrow" href="mailto:xupeng.chen@nyu.edu">Email</a></li>
        </ul>
      </div>
      <div class="hero-fig wl-rise" style="--i:4">
        <CortexTraces />
      </div>
    </section>

    <section class="wl-section" aria-labelledby="h-work">
      <div class="wl-section-head">
        <span class="wl-label">01</span>
        <h2 id="h-work">Selected work</h2>
      </div>
      <div>
        <div class="wl-rows">
          {work.map((w) => (
            <a class="wl-row" href={w.href} rel="noopener">
              <span class="wl-label">{w.year}</span>
              <span class="wl-row-title">{w.title}</span>
              <span class="wl-label wl-row-aside">{w.venue}</span>
              {w.note && <span class="wl-row-sub">{w.note}</span>}
            </a>
          ))}
        </div>
        <p class="wl-section-foot"><a class="wl-arrow" href="/about#publications">All publications</a></p>
      </div>
    </section>

    <section class="wl-section" aria-labelledby="h-writing">
      <div class="wl-section-head">
        <span class="wl-label">02</span>
        <h2 id="h-writing">Notebook</h2>
      </div>
      <div>
        <div class="wl-rows">
          {latest.map((p) => (
            <a class="wl-row" href={getPermalink(p.permalink, 'post')}>
              <time class="wl-label" datetime={p.publishDate.toISOString()}>{fmt.format(p.publishDate)}</time>
              <span class="wl-row-title">{p.title}</span>
              {p.category && <span class="wl-label wl-row-aside">{p.category.title}</span>}
            </a>
          ))}
        </div>
        <p class="wl-section-foot"><a class="wl-arrow" href="/blog">All {posts.length} posts, since {firstYear}</a></p>
      </div>
    </section>

    <section class="wl-section" aria-labelledby="h-rooms">
      <div class="wl-section-head">
        <span class="wl-label">03</span>
        <h2 id="h-rooms">Other rooms</h2>
      </div>
      <ul class="rooms">
        {rooms.map((r) => (
          <li>
            <a href={r.href} {...(r.reload ? { 'data-astro-reload': true } : {})}>
              <span class="wl-label">{r.kind}</span>
              <span class="room-title">{r.title}{r.zh && <span lang="zh"> · {r.zh}</span>}</span>
              <span class="room-desc">{r.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<style>
  .hero { padding-block: clamp(3rem, 9vw, 7.5rem) clamp(3rem, 6vw, 5rem); }
  .hero h1 {
    margin-top: 1.25rem;
    font-size: clamp(3.75rem, 14.5vw, 12.5rem);
    font-weight: 300; line-height: 0.86; letter-spacing: -0.05em;
    font-variation-settings: 'opsz' 72;
  }
  .hero h1 em { font-style: italic; font-weight: 300; letter-spacing: -0.045em; }
  .hero-eyebrow { display: flex; align-items: baseline; gap: 1.1rem; }
  .hero-eyebrow [lang='zh'] { font: 700 0.9375rem/1 var(--cjk), serif; letter-spacing: 0.32em; color: var(--ink); }
  .hero-grid {
    display: grid; grid-template-columns: minmax(0, 34rem) auto; justify-content: space-between; align-items: end; gap: 2rem 4rem;
    margin-top: clamp(2rem, 4vw, 3.25rem);
  }
  .hero-lede { font-size: clamp(1.1875rem, 1.9vw, 1.5rem); line-height: 1.45; color: var(--ink-2); letter-spacing: -0.008em; text-wrap: pretty; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 0.9rem 1.75rem; padding-bottom: 0.4rem; }
  .hero-fig { margin-top: clamp(2.5rem, 6vw, 4.5rem); }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
  }

  .rooms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--rule); }
  .rooms li { border-bottom: 1px solid var(--rule); }
  .rooms li:nth-child(odd) { border-right: 1px solid var(--rule); }
  .rooms a {
    display: grid; gap: 0.5rem; height: 100%;
    padding: 1.5rem 1.5rem 1.6rem 0; color: inherit; text-decoration: none;
    transition: background 0.2s, padding 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .rooms li:nth-child(even) a { padding-left: 1.5rem; }
  .rooms a:hover { background: var(--paper-2); padding-left: 1.1rem; }
  .rooms li:nth-child(even) a:hover { padding-left: 2.1rem; }
  .room-title { font-size: 1.4375rem; line-height: 1.2; letter-spacing: -0.015em; transition: color 0.18s; }
  .room-title span { color: var(--ink-3); font-size: 0.8em; }
  .rooms a:hover .room-title { color: var(--accent); }
  .room-desc { font-size: 0.9375rem; line-height: 1.5; color: var(--ink-3); max-width: 26rem; }
  @media (max-width: 640px) {
    .rooms { grid-template-columns: 1fr; }
    .rooms li:nth-child(odd) { border-right: 0; }
    .rooms li:nth-child(even) a { padding-left: 0; }
    .rooms a:hover, .rooms li:nth-child(even) a:hover { padding-left: 0.6rem; }
  }
</style>
