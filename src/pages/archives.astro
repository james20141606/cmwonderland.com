---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

const posts = await fetchPosts();

const postsByYear: Record<number, typeof posts> = {};
for (const post of posts) {
  const year = post.publishDate.getUTCFullYear();
  (postsByYear[year] ??= []).push(post);
}
const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
const fmt = new Intl.DateTimeFormat('en', { month: 'short', day: '2-digit', timeZone: 'UTC' });

const metadata = { title: 'Archives' };
---

<Layout metadata={metadata}>
  <div class="wl-wrap">
    <PageIntro
      label={`${posts.length} entries · ${years[years.length - 1]}–${years[0]}`}
      title="Archives"
      lede="Everything in the notebook, newest first."
    >
      <nav class="wl-chips arch-years" aria-label="Jump to year">
        {years.map((y) => <a class="wl-chip" href={`#y${y}`}>{y} <small>{postsByYear[y].length}</small></a>)}
      </nav>
    </PageIntro>

    {years.map((year) => (
      <section class="wl-section" id={`y${year}`} aria-labelledby={`h${year}`}>
        <div class="wl-section-head">
          <span class="wl-label">{postsByYear[year].length} {postsByYear[year].length === 1 ? 'entry' : 'entries'}</span>
          <h2 id={`h${year}`} class="arch-year">{year}</h2>
        </div>
        <div class="wl-rows">
          {postsByYear[year].map((post) => (
            <a class="wl-row" href={getPermalink(post.permalink, 'post')}>
              <time class="wl-label" datetime={post.publishDate.toISOString()}>{fmt.format(post.publishDate)}</time>
              <span class="wl-row-title">{post.title}</span>
              {post.category && <span class="wl-label wl-row-aside">{post.category.title}</span>}
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .arch-years { margin-top: 2rem; }
  .arch-year { font-style: normal !important; font-size: 2.5rem !important; font-weight: 300 !important; letter-spacing: -0.04em !important; font-variant-numeric: tabular-nums; }
</style>
