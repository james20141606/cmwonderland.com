---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
---

<Layout metadata={{ title: 'Page not found' }}>
  <div class="wl-wrap">
    <PageIntro
      label="Error 404"
      title="Down the <em>wrong</em> rabbit hole."
      lede="This page doesn't exist, or it moved when the site was rebuilt."
      ledeZh="这一页不存在，或者在网站重建时搬走了。"
    >
      <p style="display:flex; gap:1.75rem; flex-wrap:wrap; margin-top:2.5rem">
        <a class="wl-arrow" href="/">Home</a>
        <a class="wl-arrow" href="/blog">The notebook</a>
        <a class="wl-arrow" href="/archives">Archives</a>
      </p>
    </PageIntro>
  </div>
</Layout>
