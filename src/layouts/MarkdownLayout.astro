---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/PageIntro.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
    label?: string;
    subtitle?: string;
    subtitleZh?: string;
    hero?: boolean;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <div class="wl-wrap">
    {frontmatter?.hero !== false && frontmatter?.title && (
      <PageIntro
        label={frontmatter.label}
        title={String(frontmatter.title)}
        lede={frontmatter.subtitle}
        ledeZh={frontmatter.subtitleZh}
      />
    )}
    <div class="wl-prose wl-page-prose">
      <slot />
    </div>
  </div>
</Layout>

<style is:global>
  .wl-page-prose { max-width: 46rem; padding-top: 2.5rem; border-top: 1px solid var(--rule-strong); }
</style>
