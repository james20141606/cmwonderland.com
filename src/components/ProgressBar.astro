---
// Reading progress: a 2px accent line at the top of the viewport.
---
<div id="progress-bar" class="wl-progress" aria-hidden="true"></div>
<script is:inline>
(function () {
  if (window.__wlProgress) return;
  window.__wlProgress = true;
  function update() {
    var bar = document.getElementById('progress-bar');
    if (!bar) return;
    var h = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = h > 0 ? Math.min((window.scrollY / h) * 100, 100) + '%' : '0';
  }
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update, { passive: true });
  document.addEventListener('astro:page-load', update);
  update();
})();
</script>
