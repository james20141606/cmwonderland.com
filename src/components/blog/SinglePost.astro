---
// KaTeX styles are bundled here so only post pages pay for them (the old CDN
// link had a wrong SRI hash and was being blocked).
import 'katex/dist/katex.min.css';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import TableOfContents from '~/components/blog/TableOfContents.astro';

import { getPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
const date = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(post.publishDate);
// Mostly-Chinese posts get looser leading and no italics.
const isZh = /[一-鿿]/.test(post.title);
---

<article class="wl-wrap" lang={isZh ? 'zh' : undefined}>
  <header class="wl-article-head">
    <p class="wl-label wl-article-meta">
      <time datetime={post.publishDate.toISOString()}>{date}</time>
      {post.category && <a href={getPermalink(post.category.slug, 'category')}>{post.category.title}</a>}
      {post.readingTime && <span>{post.readingTime} min read</span>}
      <span><span id="busuanzi_value_page_pv">–</span> views</span>
    </p>
    <h1>{post.title}</h1>
    {post.excerpt && <p class="wl-article-dek">{post.excerpt}</p>}
  </header>

  <div class="wl-article-body" data-article-body>
    <TableOfContents />
    <div>
      <div class="wl-prose" data-prose>
        <slot />
      </div>
      <footer class="wl-article-foot">
        <PostTags tags={post.tags} />
        <SocialShare url={url} text={post.title} class="wl-share" />
      </footer>
    </div>
  </div>
</article>

<style is:global>
  .wl-share { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ink-3); font: 500 0.6875rem/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .wl-share button { color: var(--ink-3); transition: color 0.15s; margin: 0 !important; }
  .wl-share button:hover { color: var(--accent); }
</style>
