---
// Table of contents: built client-side from the article headings, shown as a
// sticky side rail on wide screens, with the section in view marked.
---

<nav class="wl-toc" id="toc-container" aria-label="On this page" hidden>
  <span class="wl-label">On this page</span>
  <ol id="toc-list"></ol>
</nav>

<script is:inline>
(function () {
  if (window.__wlToc) return;
  window.__wlToc = true;
  var io = null;

  function build() {
    if (io) { io.disconnect(); io = null; }
    var nav = document.getElementById('toc-container');
    var list = document.getElementById('toc-list');
    var prose = document.querySelector('[data-prose]');
    var body = document.querySelector('[data-article-body]');
    if (!nav || !list || !prose || !body) return;

    var headings = prose.querySelectorAll('h1, h2, h3, h4');
    if (headings.length < 3) { nav.hidden = true; body.dataset.toc = 'false'; return; }

    var min = 6;
    headings.forEach(function (h) { min = Math.min(min, +h.tagName[1]); });
    list.innerHTML = '';
    var links = {};
    var used = {};
    headings.forEach(function (h, i) {
      if (!h.id) {
        var base = h.textContent.trim().toLowerCase().replace(/[^\w一-鿿\s-]/g, '').replace(/\s+/g, '-') || 'section';
        var id = base, n = 2;
        while (used[id] || document.getElementById(id)) id = base + '-' + n++;
        h.id = id;
      }
      used[h.id] = true;
      var li = document.createElement('li');
      var a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent;
      a.dataset.depth = String(Math.min(+h.tagName[1] - min + 2, 4));
      li.appendChild(a); list.appendChild(li);
      links[h.id] = a;
    });
    nav.hidden = false; body.dataset.toc = 'true';

    io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        Object.keys(links).forEach(function (k) { links[k].removeAttribute('aria-current'); });
        links[e.target.id] && links[e.target.id].setAttribute('aria-current', 'true');
      });
    }, { rootMargin: '-80px 0px -70% 0px' });
    headings.forEach(function (h) { io.observe(h); });
  }

  document.addEventListener('astro:page-load', build);
  if (document.readyState !== 'loading') build();
})();
</script>
