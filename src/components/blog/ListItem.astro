---
import PostTags from '~/components/blog/Tags.astro';

import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const link = getPermalink(post.permalink, 'post');
const date = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(post.publishDate);
---

<article class="wl-post">
  <div class="wl-post-meta">
    <time class="wl-label" datetime={post.publishDate.toISOString()}>{date}</time>
    {post.category && (
      <a class="wl-label" href={getPermalink(post.category.slug, 'category')}>{post.category.title}</a>
    )}
  </div>
  <div>
    <h2>
      {post.featured && <span class="wl-label wl-pin">Pinned</span>}
      <a href={link}>{post.title}</a>
    </h2>
    {post.excerpt && <p class="wl-post-excerpt">{post.excerpt}</p>}
    {post.tags && post.tags.length > 0 && <PostTags tags={post.tags} />}
  </div>
</article>
