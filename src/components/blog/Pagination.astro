---
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

const { prevUrl, nextUrl, prevText = 'Newer posts', nextText = 'Older posts' } = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <nav class="wl-pager" aria-label="Pagination">
      {prevUrl ? <a href={getPermalink(prevUrl)} rel="prev">← {prevText}</a> : <span>·</span>}
      {nextUrl ? <a href={getPermalink(nextUrl)} rel="next">{nextText} →</a> : <span>·</span>}
    </nav>
  )
}
