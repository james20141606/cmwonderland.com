---
import { getPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  tags: Post['tags'];
  class?: string;
  title?: string | undefined;
  isCategory?: boolean;
}

const { tags, class: className = '', isCategory = false } = Astro.props;
---

{
  tags && Array.isArray(tags) && tags.length > 0 && (
    <ul class:list={['wl-tags', className]}>
      {tags.map((tag) => (
        <li>
          <a href={getPermalink(tag.slug, isCategory ? 'category' : 'tag')}>{tag.title}</a>
        </li>
      ))}
    </ul>
  )
}
