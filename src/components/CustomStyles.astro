---
// Latin fonts are self-hosted through fontsource (no Google Fonts: it is blocked
// in mainland China). Chinese uses the system Songti: a CJK webfont costs ~40 KB
// per slice and a page touches 20+ slices, which took the home page LCP to 6 s.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '~/assets/styles/site.css';
---

<!-- Bridge: leftover AstroWind widgets read these; all values come from site.css tokens. -->
<style is:inline>
  :root, .dark {
    --aw-font-sans: var(--sans);
    --aw-font-serif: var(--serif);
    --aw-font-heading: var(--serif);
    --aw-color-primary: var(--accent);
    --aw-color-secondary: var(--accent);
    --aw-color-accent: var(--accent);
    --aw-color-text-heading: var(--ink);
    --aw-color-text-default: var(--ink);
    --aw-color-text-muted: var(--ink-3);
    --aw-color-bg-page: var(--paper);
    --aw-color-bg-page-dark: var(--paper);
  }
</style>
