---
// Floating back-to-top button
---
<button id="back-to-top" class="wl-top" type="button" aria-label="Back to top" data-show="false">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
</button>
<script is:inline>
(function () {
  if (window.__wlTop) return;
  window.__wlTop = true;
  function toggle() {
    var btn = document.getElementById('back-to-top');
    if (btn) btn.dataset.show = String(window.scrollY > 600);
  }
  window.addEventListener('scroll', toggle, { passive: true });
  document.addEventListener('click', function (e) {
    if (e.target.closest('#back-to-top')) window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  document.addEventListener('astro:page-load', toggle);
  toggle();
})();
</script>
