---
export interface Props {
  label?: string;
  title: string; // may contain <em>
  lede?: string;
  ledeZh?: string;
}
const { label, title, lede, ledeZh } = Astro.props;
---

<header class="wl-intro">
  {label && <p class="wl-label">{label}</p>}
  <h1 set:html={title} />
  {(lede || ledeZh) && (
    <p class="wl-intro-lede">
      {lede}
      {ledeZh && <span lang="zh">{ledeZh}</span>}
    </p>
  )}
  <slot />
</header>
